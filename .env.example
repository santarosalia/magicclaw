# API (apps/api)
OPENAI_API_KEY=sk-...

# Mem0 Platform (cloud) — memory provider mode=platform
# MEM0_API_KEY=m0-...

# Mem0 OSS (self-hosted) — memory provider mode=oss
# OPENAI_API_KEY is used by default for LLM + embedder
# MEM0_MODE=oss

# Web (apps/web) - optional
# NEXT_PUBLIC_API_URL=http://localhost:4000

# API server port (default 4000)
# PORT=4000

# CORS origin for API (default http://localhost:3000)
# WEB_ORIGIN=http://localhost:3000
