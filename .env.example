# API (apps/api)
OPENAI_API_KEY=sk-...

# Optional: force context window for all models (tokens).
# When unset, uses the active LLM config value (discovered on connect) or 65536.
# AGENT_CONTEXT_WINDOW=131072

# Mem0 Platform (cloud) — memory provider mode=platform
# MEM0_API_KEY=m0-...

# Mem0 OSS (self-hosted) — memory provider mode=oss
# OPENAI_API_KEY is used by default for LLM + embedder
# MEM0_MODE=oss

# Web (apps/web) - optional
# NEXT_PUBLIC_API_URL=http://localhost:4000

# API server port (default 4000)
# PORT=4000

# Web UI port (default 3000)
# WEB_PORT=3000

# CORS origin for API (default http://localhost:3000)
# WEB_ORIGIN=http://localhost:3000
